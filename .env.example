# Antagonistic Robot — Environment Variables
# Copy this file to .env and fill in your API keys.
#
#   cp .env.example .env

# LLM API key (Grok / x.ai or any OpenAI-compatible provider)
GROK_API_KEY=your-api-key-here

# OpenAI API key: only needed when nao.use_builtin_tts is false (local TTS)
OPENAI_API_KEY=your-api-key-here
