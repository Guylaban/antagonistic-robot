# RAWR environment variables
# Copy this file to .env and fill in your API key.
#
#   cp .env.example .env

# LLM API key (Grok / x.ai or any OpenAI-compatible provider).
# Also used by the optional psychosocial monitor (monitor.api_key_env).
GROK_API_KEY=your-api-key-here

# Optional: key for the fidelity judge (fidelity.judge_api_key_env, default OpenAI)
# OPENAI_API_KEY=your-api-key-here
